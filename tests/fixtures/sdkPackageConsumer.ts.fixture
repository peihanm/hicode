import {
    definePillarTool,
    loadPillarHostConfig,
    Pillar,
    type PillarFileSources,
    type ThreadEvent,
    type TurnResult,
} from "pillar-core-sdk";
import {z} from "zod";

const hostLookup = definePillarTool({
    name: "host_lookup",
    description: "Look up a value owned by the SDK Host",
    parameters: z.object({key: z.string()}),
    readOnly: true,
    concurrencySafe: true,
    execute(input, context) {
        const key: string = input.key;
        const threadId: string = context.threadId;
        return `${key}:${threadId}`;
    },
});

const fileSources: PillarFileSources = {
    settings: [],
    instructions: [],
    skills: [],
    agents: [],
    mcp: [],
    lsp: [],
};

const loaded = loadPillarHostConfig({
    cwd: "/workspace",
    pillarHome: "/host-data/pillar",
    fileSources,
});

function acceptEvent(event: ThreadEvent): number {
    return event.sequence;
}

function acceptResult(result: TurnResult): string {
    return result.finalResponse;
}

void Pillar.create;
void loaded.configuration;
void hostLookup;
void acceptEvent;
void acceptResult;
