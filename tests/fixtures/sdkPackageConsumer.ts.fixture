import {
    defineHiCodeTool,
    loadHiCodeHostConfig,
    HiCode,
    type HiCodeFileSources,
    type ThreadEvent,
    type TurnResult,
} from "hicode-core-sdk";
import {z} from "zod";

const hostLookup = defineHiCodeTool({
    name: "host_lookup",
    description: "Look up a value owned by the SDK Host",
    parameters: z.object({key: z.string()}),
    readOnly: true,
    concurrencySafe: true,
    execute(input, context) {
        const key: string = input.key;
        const threadId: string = context.threadId;
        return `${key}:${threadId}`;
    },
});

const fileSources: HiCodeFileSources = {
    settings: [],
    instructions: [],
    skills: [],
    agents: [],
    mcp: [],
};

const loaded = loadHiCodeHostConfig({
    cwd: "/workspace",
    hicodeHome: "/host-data/hicode",
    fileSources,
});

function acceptEvent(event: ThreadEvent): number {
    return event.sequence;
}

function acceptResult(result: TurnResult): string {
    return result.finalResponse;
}

void HiCode.create;
void loaded.configuration;
void hostLookup;
void acceptEvent;
void acceptResult;
