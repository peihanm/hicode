{
  "name": "pillar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pillar": "src/index.tsx"
  },
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun src/index.tsx",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:contract": "bun test tests/contract",
    "test:integration": "bun test tests/integration",
    "test:ui": "bun test tests/ui",
    "diagnose:llm-stall": "bun tests/diagnostics/llmStreamReplay.ts",
    "diagnose:qwen-tool-stream": "bun tests/diagnostics/qwenToolStream.ts",
    "diagnose:deepseek-tool-stream": "bun tests/diagnostics/deepseekToolStream.ts",
    "check": "tsc --noEmit",
    "verify": "bun test && bun run check"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.66",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "turndown": "^7.2.4",
    "vscode-languageserver-protocol": "^3.17.5",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/turndown": "^5.0.6",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
