# 两个模型槽位彼此独立；Provider 可选 glm | qwen | deepseek | jeniya
PILLAR_PRIMARY_PROVIDER=qwen
PILLAR_PRIMARY_MODEL=qwen3.6-plus
PILLAR_FAST_PROVIDER=qwen
PILLAR_FAST_MODEL=qwen3.6-flash

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PILLAR_REASONING_EFFORT=high

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://trial.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# DeepSeek 官方 API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROBE_MODEL=deepseek-v4-pro

JENIYA_API_KEY=
JENIYA_BASE_URL=https://jeniya.cn/v1
